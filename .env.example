# Copy to .env (gitignored) and adjust. Read by docker compose now, and by pydantic-settings from Phase 1.
POSTGRES_USER=pkm
POSTGRES_PASSWORD=pkm
POSTGRES_DB=pkm
POSTGRES_PORT=5432
REDIS_CACHE_PORT=6379
REDIS_QUEUE_PORT=6380

# Used by the app (Phase 1+). Host-side values; containers will use host.docker.internal for Ollama.
DATABASE_URL=postgresql+asyncpg://pkm:pkm@localhost:5432/pkm
# Celery broker: AOF + noeviction (jobs must never be lost)
REDIS_QUEUE_URL=redis://localhost:6380/0
# Cache: allkeys-lru, no persistence (everything is recomputable)
REDIS_CACHE_URL=redis://localhost:6379/0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
